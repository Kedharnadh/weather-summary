<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_dark_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_temp"
            style="@style/Widget.WeatherSummary.Text.Temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°" />

        <TextView
            android:id="@+id/widget_condition"
            style="@style/Widget.WeatherSummary.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="--" />

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_weather_partly_cloudy"
            android:contentDescription="@string/app_name" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_summary"
        style="@style/Widget.WeatherSummary.Text.Detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/summary_unavailable" />

</LinearLayout>