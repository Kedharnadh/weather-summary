    "icons": "node scripts/generate-icons.mjs",
    "icons:preview": "vite-node scripts/render-preview.ts",
    "icons:ascii": "vite-node scripts/ascii-preview.ts",
    "icons:analyze": "vite-node scripts/analyze-icons.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
