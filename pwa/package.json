{
  "name": "weather-summary-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Installable low-poly weather summary powered by Open-Meteo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
