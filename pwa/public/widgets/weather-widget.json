{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "Image",
              "url": "${iconUrl}",
              "size": "Small",
              "altText": "Weather Summary"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${location}",
              "weight": "Bolder",
              "size": "Medium",
              "wrap": true,
              "spacing": "None"
            },
            {
              "type": "TextBlock",
              "text": "${updated}",
              "size": "Small",
              "isSubtle": true,
              "wrap": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${temperature}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${condition}",
      "size": "Medium",
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "${summary}",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${rain}",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${feels}",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "None"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Open Weather Summary",
      "verb": "open-app"
    }
  ]
}
